# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host:5432/jiku?sslmode=require"

# App
# In production this must be https, and it is what every link in every email
# is built from.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth (NextAuth v5)
AUTH_SECRET="your-secret-here"
# Optional: sign-in with Google. Without these, only email + password works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Guest sessions (booking without an account).
# Signs the `guest-token` cookie. Falls back to AUTH_SECRET (domain-separated)
# if unset — but a dedicated secret is preferred. Generate with:
#   openssl rand -base64 32
GUEST_JWT_SECRET=""

# MercadoPago (B2C — appointment payments)
MERCADOPAGO_ACCESS_TOKEN=""
# Required: webhooks are rejected without it.
MERCADOPAGO_WEBHOOK_SECRET=""

# Platform billing (Jiku's own MercadoPago account for subscription revenue)
MP_PLATFORM_ACCESS_TOKEN=""
MP_PLAN_PROFESSIONAL_ID=""
MP_PLAN_ENTERPRISE_ID=""
# OAuth: deja que cada negocio vincule su propio Mercado Pago con un botón.
# El redirect URI de la aplicación tiene que ser exactamente
#   https://<dominio>/api/mercadopago/oauth/callback
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""

# Resend (Email)
RESEND_API_KEY=""
# The domain must be verified in Resend (SPF + DKIM + DMARC) or nothing is
# delivered. Email is the only notification channel the product has.
RESEND_FROM="Jiku <noreply@jikuapp.com>"

# Scheduled jobs (see vercel.json). Vercel Cron sends this as
# `Authorization: Bearer <secret>`. Without it the cron endpoints return 401.
#   openssl rand -base64 32
CRON_SECRET=""
# Legacy name, still accepted by the reminders endpoint. Prefer CRON_SECRET.
REMINDERS_SECRET=""

# Encrypts secrets stored in the database (each business's MercadoPago token).
# Falls back to AUTH_SECRET, domain-separated. Rotating it makes already stored
# tokens unreadable — businesses would have to re-enter them.
ENCRYPTION_KEY=""

# Optional: Upstash Redis makes rate limits global instead of per serverless
# instance. Without it, limits are enforced per process and easily exceeded.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudinary (image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="jiku"
